{
  "name": "jigsaw-website",
  "version": "1.0.0",
  "description": "Jigsaw Education Evidence \u2014 website and design system",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next/cache/fetch-cache && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "assets:migrate": "node --env-file-if-exists=.env.local scripts/migrate-assets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.0.20",
    "@fontsource/lato": "^5.0.20",
    "@tailwindcss/postcss": "^4.3.3",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "bcryptjs": "^3.0.3",
    "boneyard-js": "^1.8.1",
    "cobe": "^2.0.1",
    "d3-geo": "^3.1.1",
    "jose": "^6.2.8",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "sharp@0.34.5": true
  }
}
